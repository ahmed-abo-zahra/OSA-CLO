# Set to true only for local, isolated presentation mode. Keep false on Vercel.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Customer email confirmation/recovery also requires Email provider, allowed Redirect URLs, and custom SMTP in Supabase Auth settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=  # Optional public business contact; digits only.

# Server-only secret API key. Never use a secret/service-role key in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Use at least 32 random characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional separate stable key for private order-tracking links; falls back to ADMIN_SESSION_SECRET.
ORDER_TRACKING_SECRET=

# Partner login secrets; set each to a unique, long random value.
ADMIN_PASSWORD_PARTNER_A=
ADMIN_PASSWORD_PARTNER_B=
ADMIN_PASSWORD_PARTNER_C=
