# Set to true only for local, isolated presentation mode. Keep false on Vercel.
NEXT_PUBLIC_DEMO_MODE=false

# Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret API key. Never use a secret/service-role key in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Use at least 32 random characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Partner login secrets; set each to a unique, long random value.
ADMIN_PASSWORD_SAFIA=
ADMIN_PASSWORD_OMAIMA=
ADMIN_PASSWORD_AISHA=
