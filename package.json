{
  "name": "aso-clo-store",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test:security": "node --experimental-strip-types --test scripts/test-trusted-client-ip.mjs scripts/test-request-security.mjs scripts/test-tracking-token.mjs scripts/test-internal-redirect.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:security && node scripts/validate-catalog.mjs && node scripts/validate-frontend.mjs && node scripts/validate-backend.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.106.1",
    "fuse.js": "^7.3.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
